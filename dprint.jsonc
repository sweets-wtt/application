{
  // 行宽 - 与 Ruff、oxfmt 统一为 100
  "lineWidth": 100,
  // 缩进宽度 - 与 .editorconfig 一致
  "indentWidth": 2,
  // 缩进 - 空格
  "useTabs": false,
  // 换行符 - 统一 LF
  "newLineKind": "lf",
  // 增量格式化 - 仅处理变更文件
  "incremental": true,
  // 排除 - 生成物与依赖目录
  "excludes": [
    // 契约打包制品
    "contracts/http/dist/**",
    // TypeScript 契约客户端
    "apps/web/src/contracts/http/**",
    // TypeScript 契约模式
    "apps/web/src/contracts/schemas/**",
    // Python 契约模型
    "apps/server/src/server/generated/contracts.py",
    // JavaScript 依赖
    "**/node_modules/**",
    // Python 虚拟环境
    ".venv/**"
  ],
  // JSON / JSONC
  "json": {
    // 放得下的数组强制单行
    "array.preferSingleLine": true,
    // 放得下的对象强制单行
    "object.preferSingleLine": true,
    // 禁止尾逗号
    "trailingCommas": "never"
  },
  // Markdown
  "markdown": {
    // 强调符号
    "emphasisKind": "asterisks",
    // 无序列表标记
    "list.unorderedMarker": "asterisks",
    // 文本折行 - 按行宽统一
    "textWrap": "always"
  },
  // TOML
  "toml": {
    // 放得下的数组强制单行
    "array.preferSingleLine": true,
    // 放得下的内联表强制单行
    "inlineTable.preferSingleLine": true,
    // 键按字母排序
    "sortKeys": true
  },
  // 插件
  "plugins": [
    // Dockerfile
    "npm:@dprint/dockerfile@0.7.0",
    // JSON / JSONC
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    // Markdown
    "https://plugins.dprint.dev/markdown-0.28.2.wasm",
    // YAML
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    // TOML
    "https://plugins.dprint.dev/toml-0.9.0.wasm"
  ]
}

{
  // 排除
  "excludes": [
    // 契约打包制品
    "contracts/http/dist/**",
    // TypeScript 契约生成物
    "apps/web/src/api/generated/**",
    // Python 契约模型
    "apps/server/src/server/generated/contracts.py",
    // JavaScript 依赖
    "**/node_modules/**",
    // Python 虚拟环境
    ".venv/**"
  ],
  // 增量格式化
  "incremental": true,
  // 缩进宽度
  "indentWidth": 2,
  // JSON / JSONC
  "json": {
    // 放得下的数组强制单行
    "array.preferSingleLine": true,
    // 放得下的对象强制单行
    "object.preferSingleLine": true,
    // package.json 按 npm 约定顺序
    "packageJson.applyConventions": true,
    // 禁止尾逗号
    "trailingCommas": "never"
  },
  // 行宽
  "lineWidth": 100,
  // Markdown
  "markdown": {
    // 强调符号
    "emphasisKind": "asterisks",
    // 无序列表标记
    "list.unorderedMarker": "asterisks",
    // 文本折行
    "textWrap": "always"
  },
  // 换行符
  "newLineKind": "lf",
  // 插件
  "plugins": [
    // Dockerfile
    "npm:@dprint/dockerfile@0.7.0",
    // JSON / JSONC
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    // Markdown
    "https://plugins.dprint.dev/markdown-0.28.2.wasm",
    // YAML
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    // TOML
    "https://plugins.dprint.dev/toml-0.9.0.wasm"
  ],
  // TOML
  "toml": {
    // 放得下的数组强制单行
    "array.preferSingleLine": true,
    // 放得下的内联表强制单行
    "inlineTable.preferSingleLine": true,
    // 数组值字母序
    "sortArrays": true,
    // 内联表键字母序
    "sortInlineTables": true,
    // 表内键字母序
    "sortKeys": true
  },
  // 缩进
  "useTabs": false
}

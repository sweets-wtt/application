{
  // Schema 地址
  "$schema": "https://dprint.dev/schemas/v0.json",
  // 包含路径
  "includes": ["**/*.{json,jsonc,md,yaml,toml}", "**/Dockerfile"],
  // 排除路径
  "excludes": ["**/node_modules/**", ".venv/**", "**/dist/**"],
  // 行宽
  "lineWidth": 120,
  // 插件
  "plugins": [
    "npm:@dprint/dockerfile@0.7.0",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/markdown-0.28.2.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm"
  ],
  // Dockerfile 插件
  "dockerfile": {
    // 缩进构建阶段
    "indentStages": true
  },
  // JSON 插件
  "json": {
    // 数组折叠单行
    "array.preferSingleLine": true,
    // 对象折叠单行
    "object.preferSingleLine": true,
    // 尾逗号
    "trailingCommas": "never"
  },
  // Markdown 插件
  "markdown": {
    // 强调符号
    "emphasisKind": "asterisks",
    // 无序列表符号
    "list.unorderedMarker": "asterisks",
    // 文本折行
    "textWrap": "always"
  },
  // YAML 插件
  "yaml": {
    // 注释前导空格
    "formatComments": true
  },
  // TOML 插件
  "toml": {
    // 数组折叠单行
    "array.preferSingleLine": true,
    // 内联表折叠单行
    "inlineTable.preferSingleLine": true,
    // 数组排序
    "sortArrays": true,
    // 内联表排序
    "sortInlineTables": true,
    // 键排序
    "sortKeys": true
  }
}

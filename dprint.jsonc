{
  // 全局 - 各插件未显式覆盖时继承
  "lineWidth": 120,
  // 排除
  "excludes": [
    // 打包制品
    "contracts/http/dist/**",
    // 契约生成物
    "apps/web/src/contracts/http/**",
    "apps/web/src/contracts/schemas/**",
    "apps/server/src/server/generated/contracts.py"
  ],
  // JSON / JSONC
  "json": {
    // 放得下的数组强制单行
    "array.preferSingleLine": true,
    // 放得下的对象强制单行
    "object.preferSingleLine": true,
    // 禁止尾逗号
    "trailingCommas": "never"
  },
  // Markdown
  "markdown": {
    // 强调符号
    "emphasisKind": "asterisks",
    // 无序列表标记
    "list.unorderedMarker": "asterisks"
  },
  // TOML
  "toml": {
    // 放得下的数组强制单行
    "array.preferSingleLine": true,
    // 放得下的内联表强制单行
    "inlineTable.preferSingleLine": true,
    // 键按字母排序
    "sortKeys": true
  },
  // 插件
  "plugins": [
    // Dockerfile
    "npm:@dprint/dockerfile@0.7.0",
    // JSON / JSONC
    "https://plugins.dprint.dev/json-0.24.0.wasm",
    // Markdown
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    // YAML
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    // TOML
    "https://plugins.dprint.dev/toml-0.8.0.wasm"
  ]
}

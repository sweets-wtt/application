{
  // 包含文件
  "includes": [
    "**/*.json",
    "**/*.jsonc",
    "**/*.md",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/Dockerfile"
  ],
  // 排除文件
  "excludes": [
    "contracts/http/dist/**",
    "apps/web/src/api/generated/**",
    "apps/server/src/server/generated/contracts.py",
    "**/node_modules/**",
    ".venv/**",
    "**/dist/**"
  ],
  // shebang 识别
  "shebangs": { "#!/usr/bin/env bash": "sh", "#!/bin/sh": "sh", "#!/usr/bin/env python": "py" },
  // 行宽
  "lineWidth": 100,
  // 插件
  "plugins": [
    "npm:@dprint/dockerfile@0.7.0",
    "https://plugins.dprint.dev/json-0.25.2.wasm",
    "https://plugins.dprint.dev/markdown-0.28.2.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm"
  ],
  // Dockerfile 插件
  "dockerfile": { "locked": true },
  "json": {
    // 配置锁定
    "locked": true,
    // 数组单行
    "array.preferSingleLine": true,
    // 对象单行
    "object.preferSingleLine": true,
    // 行宽
    "lineWidth": 100,
    // 尾逗号
    "trailingCommas": "never"
  },
  "markdown": {
    // 配置锁定
    "locked": true,
    // 强调符号
    "emphasisKind": "asterisks",
    // 列表符号
    "list.unorderedMarker": "asterisks",
    // 行宽
    "lineWidth": 100,
    // 折行
    "textWrap": "always"
  },
  "yaml": {
    // 配置锁定
    "locked": true,
    // 行宽
    "printWidth": 100,
    // 引号
    "quotes": "preferDouble",
    // 破折号空格
    "dashSpacing": "oneSpace",
    // 流式序列单行
    "flowSequence.preferSingleLine": false,
    // 流式映射单行
    "flowMap.preferSingleLine": false
  },
  "toml": {
    // 配置锁定
    "locked": true,
    // 行宽
    "lineWidth": 100,
    // 键排序
    "sortKeys": true,
    // 数组排序
    "sortArrays": true,
    // 内联表排序
    "sortInlineTables": true,
    // 内联表单行
    "inlineTable.preferSingleLine": true,
    // 数组单行
    "array.preferSingleLine": true
  }
}

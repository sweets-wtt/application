# 根配置
root = true

# 通用规则
[*]
# 字符编码
charset = utf-8
# 换行符
end_of_line = lf
# 缩进字符
indent_style = space
# 缩进宽度
indent_size = 2
# 末尾换行
insert_final_newline = true
# 去除行尾空白
trim_trailing_whitespace = true

# Markdown 规则
[*.md]
# 去除行尾空白
trim_trailing_whitespace = false

# Makefile 规则
[Makefile]
# 缩进字符
indent_style = tab
# 缩进宽度
indent_size = tab

# Python 规则
[*.py]
# 缩进宽度
indent_size = 4

# 根配置
root = true

# 通用规则
[*]
# 字符编码
charset = utf-8
# 换行符
end_of_line = lf
# 缩进风格
indent_style = space
# 缩进宽度
indent_size = 2
# 末尾换行
insert_final_newline = true
# 行尾空白
trim_trailing_whitespace = true

# Markdown
[*.md]
# 行尾空白
trim_trailing_whitespace = false

# Makefile
[Makefile]
# 缩进风格
indent_style = tab
# 缩进宽度
indent_size = tab

# Python
[*.py]
# 缩进宽度
indent_size = 4

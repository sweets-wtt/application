# EditorConfig - `https://editorconfig.org/`

# 根配置（停止向上查找）
root = true

# 通用
[*]
# 编码
charset = utf-8
# 换行符
end_of_line = lf
# 缩进风格
indent_style = space
# 缩进宽度
indent_size = 2
# 移除行尾空白
trim_trailing_whitespace = true
# 末尾插入换行
insert_final_newline = true

# Markdown
[*.{md,markdown}]
# 移除行尾空白
trim_trailing_whitespace = false

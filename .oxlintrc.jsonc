{
  // 配置文件的 JSON Schema 地址
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // 规则分类及其严重级别
  "categories": {
    // 检测确定错误或无用的代码
    "correctness": "error",
    // 更严格但可能误报的规则
    "pedantic": "warn",
    // 运行时性能相关
    "perf": "warn",
    // 可自动修复的惯用风格
    "style": "warn",
    // 可能错误或无用的代码
    "suspicious": "warn"
  },
  // 忽略的文件模式
  "ignorePatterns": ["apps/web/src/api/generated/**"],
  // 按文件模式覆盖的规则
  "overrides": [{
    // 测试文件
    "files": ["**/*.{test,spec}.ts", "**/tests/**"],
    "rules": {
      // 单文件最大行数
      "max-lines": "off",
      // 单函数最大行数
      "max-lines-per-function": "off"
    }
  }, {
    // 端到端测试 - Playwright 约定
    "files": ["**/tests/e2e/**"],
    "rules": {
      // 测试文件命名规范
      "vitest/consistent-test-filename": "off"
    }
  }, {
    // 测试环境配置 - 顶层 hook 与显式导入
    "files": ["**/tests/setup.ts"],
    "rules": {
      // 测试 hook 的放置位置
      "vitest/require-hook": "off",
      // 顶层 describe 包裹
      "vitest/require-top-level-describe": "off",
      // ban hook 使用
      "vitest/no-hooks": "off"
    }
  }, {
    // 路由记录按语义顺序（path → component → children）
    "files": ["apps/web/src/router/**"],
    "rules": { "sort-keys": "off" }
  }, {
    // 具名导出：barrel 与多导出模块无法用单个 default 表达
    "files": [
      "apps/web/src/api/**",
      "apps/web/src/features/health/**",
      "apps/web/src/lib/logger.ts",
      "apps/web/src/lib/storage.ts"
    ],
    "rules": {
      // 禁止具名导出
      "import/no-named-export": "off",
      // 单导出文件优先 default
      "import/prefer-default-export": "off",
      // 导出语句置于文件末尾
      "import/exports-last": "off",
      // 合并具名导出声明
      "import/group-exports": "off"
    }
  }, {
    // localStorage 契约返回 null，无法以 undefined 替代
    "files": ["apps/web/src/lib/storage.ts", "apps/web/tests/unit/lib/storage.test.ts"],
    "rules": { "unicorn/no-null": "off" }
  }, {
    // Vite 插件工厂以大写命名，构建配置需引入 node 内置模块
    "files": ["apps/web/vite.config.ts"],
    "rules": {
      // 构造函数命名大写约束
      "new-cap": "off",
      // 禁止导入 Node 内置模块
      "import/no-nodejs-modules": "off"
    }
  }],
  // 全局选项
  "options": {
    // 警告是否视为失败
    "denyWarnings": true,
    // 是否报告未使用的禁用指令
    "reportUnusedDisableDirectives": "warn"
  },
  // 启用的插件
  "plugins": [
    "eslint",
    "import",
    "node",
    "oxc",
    "promise",
    "typescript",
    "unicorn",
    "vitest",
    "vue"
  ],
  // 规则开关及参数
  "rules": {
    // 圈复杂度上限，与 ruff 的 max-complexity 对齐
    "complexity": ["warn", 10],
    // if 语句强制花括号
    "curly": "warn",
    // 变量声明合并模式：每条声明独立成句
    "one-var": ["warn", "never"],
    // Import 语句排序：由 oxfmt sortImports 负责分组排序
    "sort-imports": "off",
    // 对象键字母序
    "sort-keys": ["warn", "asc", { "caseSensitive": true, "natural": true }],
    // 变量声明按字母序排列
    "sort-vars": "warn",
    // switch/case 的 default 须在最后
    "default-case-last": "warn",
    // 带默认值的参数须放在最后
    "default-param-last": "warn",
    // 要求 === / !==
    "eqeqeq": "error",
    // 类型导入说明符风格
    "import/consistent-type-specifier-style": "off",
    // import 须置于文件顶部
    "import/first": "warn",
    // import 之后须空行
    "import/newline-after-import": "warn",
    // 禁止循环依赖
    "import/no-cycle": "error",
    // 禁止重复导入
    "import/no-duplicates": "warn",
    // 副作用导入白名单
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "virtual:*"] }],
    // 单文件最大行数
    "max-lines": ["warn", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    // 单函数最大行数
    "max-lines-per-function": ["warn", { "max": 50, "skipBlankLines": true, "skipComments": true }],
    // 禁止 alert
    "no-alert": "error",
    // 禁止 debugger
    "no-debugger": "error",
    // 禁止直接使用 console
    "no-console": "warn",
    // 禁止 eval
    "no-eval": "error",
    // 禁止 else 分支仅含 if
    "no-else-return": "warn",
    // 禁止隐式类型转换
    "no-implicit-coercion": "warn",
    // 禁止隐式 eval
    "no-implied-eval": "error",
    // 禁止 if 作为 else 唯一语句
    "no-lonely-if": "warn",
    // 禁止 new Function
    "no-new-func": "error",
    // 魔法数字豁免值
    "no-magic-numbers": ["warn", { "ignore": [-1, 0, 1, 2], "ignoreArrayIndexes": true }],
    // 禁止脚本 URL
    "no-script-url": "error",
    // 赋值不得作为返回表达式
    "no-return-assign": "warn",
    // 禁止无用重命名
    "no-useless-rename": "warn",
    // 普通字符串中不得出现模板占位符
    "no-template-curly-in-string": "warn",
    // 禁止 var
    "no-var": "error",
    // 对象属性简写
    "object-shorthand": "warn",
    // 声明后未重新赋值的变量要求 const
    "prefer-const": "error",
    // 优先 Object.hasOwn
    "prefer-object-has-own": "warn",
    // 对象展开代替 Object.assign
    "prefer-object-spread": "warn",
    // 字符串拼接改用模板字符串
    "prefer-template": "warn",
    // 数组类型注解风格统一
    "typescript/array-type": "warn",
    // 统一 interface 与 type 的选择
    "typescript/consistent-type-definitions": "warn",
    // type 导入显式声明
    "typescript/consistent-type-imports": "warn",
    // 禁止空 interface
    "typescript/no-empty-interface": "warn",
    // 禁止空对象类型
    "typescript/no-empty-object-type": "warn",
    // 禁止显式 any
    "typescript/no-explicit-any": "error",
    // 禁止可推断的显式类型
    "typescript/no-inferrable-types": "warn",
    // 数组遍历用 for...of
    "typescript/prefer-for-of": "warn",
    // 优先使用 ??
    "typescript/prefer-nullish-coalescing": "warn",
    // 优先 startsWith/endsWith
    "typescript/prefer-string-starts-ends-with": "warn",
    // catch 参数命名统一
    "unicorn/catch-error-name": "warn",
    // Error 消息非空
    "unicorn/error-message": "warn",
    // 文件名命名规范 - 与 Vue 组件 PascalCase 惯例冲突
    "unicorn/filename-case": "off",
    // includes 代替 indexOf 比较
    "unicorn/prefer-includes": "warn",
    // Node 内置模块使用 node: 前缀
    "unicorn/prefer-node-protocol": "warn",
    // 可省略的 catch 参数须省略
    "unicorn/prefer-optional-catch-binding": "warn",
    // 优先 trimStart/trimEnd
    "unicorn/prefer-string-trim-start-end": "warn",
    // throw 须 new Error
    "unicorn/throw-new-error": "warn",
    // 禁止无断言的测试
    "vitest/expect-expect": "warn",
    // 禁止条件断言
    "vitest/no-conditional-expect": "warn",
    // 提示存在被禁用的测试
    "vitest/no-disabled-tests": "warn",
    // 禁止 .only 聚焦测试
    "vitest/no-focused-tests": "error",
    // 禁止重复的测试标题
    "vitest/no-identical-title": "warn",
    // 禁止 .skip/.only 前缀式聚焦
    "vitest/no-test-prefixes": "warn",
    // 显式导入 Vitest API, 项目未开启 globals
    "vitest/no-importing-vitest-globals": "off",
    // 测试用例须声明断言数量
    "vitest/prefer-expect-assertions": ["warn", { "onlyFunctionsWithAsyncKeyword": true }],
    // 保留字符串测试标题
    "vitest/prefer-describe-function-title": "off",
    // hooks 须置于测试之前
    "vitest/prefer-hooks-on-top": "warn",
    // 保持 vi.mock 字符串写法以兼容严格类型
    "vitest/prefer-import-in-mock": "off",
    // 显式导入 Vitest API, 项目未开启 globals
    "vitest/prefer-importing-vitest-globals": "off",
    // 优先使用严格相等断言
    "vitest/prefer-strict-equal": "warn",
    // 断言优先 toBe
    "vitest/prefer-to-be": "warn",
    // 布尔断言优先 toBeTruthy - 与 prefer-strict-boolean-matchers 冲突，取更严格的后者
    "vitest/prefer-to-be-truthy": "off",
    // 数组断言优先 toContain
    "vitest/prefer-to-contain": "warn",
    // 调用断言优先 toHaveBeenCalledTimes
    "vitest/prefer-to-have-been-called-times": "warn",
    // 长度断言优先 toHaveLength
    "vitest/prefer-to-have-length": "warn",
    // 显式导入 Vitest API, 项目未开启 globals
    "vitest/require-hook": "off",
    // 测试须包在顶层 describe 中
    "vitest/require-top-level-describe": "warn",
    // 要求 mock 类型参数过于严格
    "vitest/require-mock-type-parameters": "off",
    // 统一 defineEmits 声明方式
    "vue/define-emits-declaration": "warn",
    // 统一 defineProps 声明方式
    "vue/define-props-declaration": "warn",
    // 限制单个组件的 props 数量
    "vue/max-props": ["warn", { "maxProps": 10 }],
    // 禁止 await 后调用 expose
    "vue/no-expose-after-await": "error",
    // 禁止在 setup 外导入编译器宏
    "vue/no-import-compiler-macros": "error",
    // 优先从 vue 导入运行时 API
    "vue/prefer-import-from-vue": "warn",
    // 要求 ref 带类型
    "vue/require-typed-ref": "warn"
  }
}

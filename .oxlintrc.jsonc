{
  // Schema
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // 插件
  "plugins": ["unicorn", "typescript", "oxc", "import", "vitest", "vue"],

  // 规则分类
  "categories": {
    // 确定错误或无用的代码
    "correctness": "error",
    // 可能错误或无用的代码
    "suspicious": "warn",
    // 更严格但可能误报的规则
    "pedantic": "warn",
    // 运行时性能相关
    "perf": "warn"
  },

  // 规则
  "rules": {
    // 要求 === / !==
    "eqeqeq": "error",
    // 单文件最大行数
    "max-lines": ["warn", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    // 单函数最大行数
    "max-lines-per-function": [
      "warn",
      { "max": 50, "skipBlankLines": true, "skipComments": true }
    ],
    // 禁止直接使用 console
    "no-console": "warn",
    // 禁止 var
    "no-var": "error",
    // 声明后未重新赋值的变量要求 const
    "prefer-const": "error",
    // 禁止重复导入
    "import/no-duplicates": "warn",
    // 副作用导入白名单
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "virtual:*"] }],
    // 禁止显式 any
    "typescript/no-explicit-any": "error",
    // 禁止无断言的测试
    "vitest/expect-expect": "warn",
    // 提示存在被禁用的测试
    "vitest/no-disabled-tests": "warn",
    // 禁止 .only 聚焦测试
    "vitest/no-focused-tests": "error",
    // 要求 mock 类型参数过于严格
    "vitest/require-mock-type-parameters": "off"
  },

  // 按文件模式覆盖
  "overrides": [
    {
      // 测试文件
      "files": ["**/tests/**", "**/*.{test,spec}.ts"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ],

  // 忽略模式
  "ignorePatterns": ["apps/web/src/contracts/http/**", "apps/web/src/contracts/schemas/**"]
}

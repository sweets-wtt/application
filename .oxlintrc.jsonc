{
  // Schema
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",

  // 规则分类 - 未列出的分类保持默认关闭
  "categories": {
    // 正确性
    "correctness": "error",
    // 可疑
    "suspicious": "warn",
    // 严格
    "pedantic": "warn",
    // 性能
    "perf": "warn"
  },

  // 规则 - 仅保留分类未覆盖的必需项
  "rules": {
    // 基础质量 - 属 restriction 分类, 官方不建议整体启用
    "no-var": "error",
    "eqeqeq": "error",
    "prefer-const": "error",
    // 类型安全 - 属 restriction 分类
    "typescript/no-explicit-any": "error",
    // 测试卫生 - 防止误提交 only/skip
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "warn",
    // 行数上限 - 仅统计有效代码行
    "max-lines": ["warn", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "warn",
      { "max": 50, "skipBlankLines": true, "skipComments": true }
    ]
  },

  // 文件覆盖
  "overrides": [
    {
      // 测试文件 - 测试块通常较长
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/tests/**"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ],

  // 忽略路径 - 契约生成物不参与检查
  "ignorePatterns": [
    "**/packages/typescript/contracts/src/http/**",
    "**/packages/typescript/contracts/src/schemas/**"
  ]
}

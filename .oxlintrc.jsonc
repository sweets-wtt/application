{
  // Schema 地址
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // 规则类别
  "categories": {
    // 正确性
    "correctness": "warn"
  },
  // 运行选项
  "options": {
    // 警告即失败
    "denyWarnings": true,
    // 警告上限
    "maxWarnings": 0,
    // 未用禁用注释
    "reportUnusedDisableDirectives": "warn"
  },
  // 插件
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "vue",
    "vitest",
    "import",
    "promise",
    "node",
    "oxc"
  ],
  // 忽略文件
  "ignorePatterns": ["apps/web/src/api/generated/**", "apps/web/auto-imports.d.ts"],
  // 规则
  "rules": {
    // ── eslint（112 条）
    // 访问器须成对出现
    "eslint/accessor-pairs": "warn",
    // 箭头函数体统一
    "eslint/arrow-body-style": "warn",
    // 变量须声明并使用于同一作用域
    "eslint/block-scoped-var": "warn",
    // 注释首字母大写
    "eslint/capitalized-comments": "warn",
    // 类方法须使用 this
    "eslint/class-methods-use-this": "warn",
    // 圈复杂度上限
    "eslint/complexity": ["warn", 10],
    // 控制语句须用花括号
    "eslint/curly": "warn",
    // switch 须有默认分支
    "eslint/default-case": "warn",
    // 默认分支置于最后
    "eslint/default-case-last": "warn",
    // 默认参数置于最后
    "eslint/default-param-last": "warn",
    // 要求严格相等运算符
    "eslint/eqeqeq": "warn",
    // 函数名与变量名一致
    "eslint/func-name-matching": "warn",
    // 函数须具名
    "eslint/func-names": "warn",
    // for-in 循环须带条件守卫
    "eslint/guard-for-in": "warn",
    // 禁用指定标识符
    "eslint/id-denylist": "warn",
    // 标识符长度范围
    "eslint/id-length": "off",
    // 标识符须匹配指定格式
    "eslint/id-match": "warn",
    // 声明时须初始化
    "eslint/init-declarations": "warn",
    // 单文件类数量上限
    "eslint/max-classes-per-file": "warn",
    // 代码块嵌套深度上限
    "eslint/max-depth": "warn",
    // 单文件行数上限
    "eslint/max-lines": ["warn", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    // 单函数行数上限
    "eslint/max-lines-per-function": [
      "warn",
      { "max": 50, "skipBlankLines": true, "skipComments": true }
    ],
    // 回调嵌套层数上限
    "eslint/max-nested-callbacks": "warn",
    // 函数参数数量上限
    "eslint/max-params": "warn",
    // 单函数语句数上限
    "eslint/max-statements": "warn",
    // 禁止 alert 类弹窗
    "eslint/no-alert": "warn",
    // 禁止 Array 构造器
    "eslint/no-array-constructor": "warn",
    // 禁止循环内 await
    "eslint/no-await-in-loop": "warn",
    // 禁止位运算符
    "eslint/no-bitwise": "warn",
    // switch 分支内禁止声明
    "eslint/no-case-declarations": "warn",
    // 禁止 console
    "eslint/no-console": "warn",
    // 构造器禁止返回值
    "eslint/no-constructor-return": "warn",
    // 禁止 continue
    "eslint/no-continue": "warn",
    // 禁止易与除法混淆的正则
    "eslint/no-div-regex": "warn",
    // else 分支禁止仅作 return
    "eslint/no-else-return": "warn",
    // 禁止空代码块
    "eslint/no-empty": "warn",
    // 禁止空函数
    "eslint/no-empty-function": "warn",
    // 禁止用 == 比较 null
    "eslint/no-eq-null": "warn",
    // 禁止扩展原生类型原型
    "eslint/no-extend-native": "warn",
    // 禁止多余标签
    "eslint/no-extra-label": "warn",
    // 禁止隐式类型转换
    "eslint/no-implicit-coercion": "warn",
    // 禁止隐式全局变量
    "eslint/no-implicit-globals": "warn",
    // 禁止隐式 eval
    "eslint/no-implied-eval": "warn",
    // 禁止行内注释
    "eslint/no-inline-comments": "warn",
    // 禁止块内函数声明
    "eslint/no-inner-declarations": "warn",
    // 标签名不得与变量重名
    "eslint/no-label-var": "warn",
    // 禁止标签语句
    "eslint/no-labels": "warn",
    // 禁止孤立代码块
    "eslint/no-lone-blocks": "warn",
    // 禁止循环内定义函数
    "eslint/no-loop-func": "warn",
    // 禁止魔法数字
    "eslint/no-magic-numbers": [
      "warn",
      { "ignore": [-1, 0, 1, 2, 5000], "ignoreArrayIndexes": true }
    ],
    // 禁止链式赋值
    "eslint/no-multi-assign": "warn",
    // 禁止用续行符拼接字符串
    "eslint/no-multi-str": "warn",
    // 禁止取反条件判断
    "eslint/no-negated-condition": "warn",
    // 禁止嵌套三元表达式
    "eslint/no-nested-ternary": "warn",
    // 禁止仅为副作用使用 new
    "eslint/no-new": "warn",
    // 禁止 new Function
    "eslint/no-new-func": "warn",
    // 禁止 new 包装对象
    "eslint/no-new-wrappers": "warn",
    // 禁止重新赋值参数
    "eslint/no-param-reassign": "warn",
    // 禁止自增自减运算符
    "eslint/no-plusplus": "warn",
    // 禁止重复声明变量
    "eslint/no-redeclare": "warn",
    // 禁止正则中连续空格
    "eslint/no-regex-spaces": "warn",
    // 限制指定导出
    "eslint/no-restricted-exports": "warn",
    // 限制指定全局变量
    "eslint/no-restricted-globals": "warn",
    // 限制指定模块导入
    "eslint/no-restricted-imports": "warn",
    // 限制指定属性访问
    "eslint/no-restricted-properties": "warn",
    // 禁止返回赋值表达式
    "eslint/no-return-assign": "warn",
    // 禁止 javascript: 伪协议
    "eslint/no-script-url": "warn",
    // 禁止变量与自身比较
    "eslint/no-self-compare": "warn",
    // 禁止逗号运算符序列
    "eslint/no-sequences": "warn",
    // 禁止变量遮蔽外层同名变量
    "eslint/no-shadow": "warn",
    // 普通字符串中禁止模板占位符
    "eslint/no-template-curly-in-string": "warn",
    // 禁止三元表达式
    "eslint/no-ternary": "warn",
    // throw 须抛出 Error 对象
    "eslint/no-throw-literal": "warn",
    // 禁止未声明变量
    "eslint/no-undef": "off",
    // 禁止直接使用 undefined 标识符
    "eslint/no-undefined": "off",
    // 禁止标识符首尾下划线
    "eslint/no-underscore-dangle": "warn",
    // 禁止意外换行导致的歧义
    "eslint/no-unexpected-multiline": "warn",
    // 循环条件须在循环内可变
    "eslint/no-unmodified-loop-condition": "warn",
    // 禁止多余的三元表达式
    "eslint/no-unneeded-ternary": "warn",
    // 禁止最多执行一次的循环
    "eslint/no-unreachable-loop": "warn",
    // 禁止在定义前使用
    "eslint/no-use-before-define": "warn",
    // 禁止无用赋值
    "eslint/no-useless-assignment": "warn",
    // 禁止多余的 call/apply
    "eslint/no-useless-call": "warn",
    // 禁止无用的计算属性键
    "eslint/no-useless-computed-key": "warn",
    // 禁止空构造器
    "eslint/no-useless-constructor": "warn",
    // 禁止 var
    "eslint/no-var": "warn",
    // 禁止 void 运算符
    "eslint/no-void": "warn",
    // 禁止遗留告警类注释
    "eslint/no-warning-comments": "warn",
    // 对象属性须用简写
    "eslint/object-shorthand": "warn",
    // 每个作用域只允许一条声明
    "eslint/one-var": ["warn", "never"],
    // 复合运算须用赋值运算符
    "eslint/operator-assignment": "warn",
    // 优先箭头回调
    "eslint/prefer-arrow-callback": "warn",
    // 不重新赋值时须用 const
    "eslint/prefer-const": "warn",
    // 优先解构赋值
    "eslint/prefer-destructuring": "warn",
    // 优先幂运算符
    "eslint/prefer-exponentiation-operator": "warn",
    // 优先数字字面量
    "eslint/prefer-numeric-literals": "warn",
    // 优先 Object.hasOwn
    "eslint/prefer-object-has-own": "warn",
    // 优先对象展开
    "eslint/prefer-object-spread": "warn",
    // Promise 拒绝须传 Error
    "eslint/prefer-promise-reject-errors": "warn",
    // 优先剩余参数
    "eslint/prefer-rest-params": "warn",
    // 优先展开语法
    "eslint/prefer-spread": "warn",
    // 优先模板字符串
    "eslint/prefer-template": "warn",
    // 重新抛出时须保留错误原因
    "eslint/preserve-caught-error": "warn",
    // parseInt 须指定进制
    "eslint/radix": "warn",
    // 异步函数须包含 await
    "eslint/require-await": "warn",
    // 导入语句须排序
    "eslint/sort-imports": "off",
    // 对象键须排序
    "eslint/sort-keys": ["warn", "asc", { "caseSensitive": true, "natural": true }],
    // 变量声明须排序
    "eslint/sort-vars": "warn",
    // Symbol 须提供描述
    "eslint/symbol-description": "warn",
    // 禁止文件头 BOM
    "eslint/unicode-bom": "warn",
    // 变量声明须置于作用域顶部
    "eslint/vars-on-top": "warn",
    // 禁止尤达条件写法
    "eslint/yoda": "warn",
    // ── typescript（79 条）
    // 重载签名须相邻
    "typescript/adjacent-overload-signatures": "warn",
    // 数组类型统一
    "typescript/array-type": "warn",
    // 禁止未说明原因的 @ts 指令
    "typescript/ban-ts-comment": "warn",
    // 禁止 TSLint 指令注释
    "typescript/ban-tslint-comment": "warn",
    // 禁止原生包装类型
    "typescript/ban-types": "warn",
    // 类字面量属性统一
    "typescript/class-literal-property-style": "warn",
    // 泛型构造器统一
    "typescript/consistent-generic-constructors": "warn",
    // 索引签名与 Record 统一
    "typescript/consistent-indexed-object-style": "warn",
    // 函数返回值统一
    "typescript/consistent-return": "warn",
    // 类型断言统一
    "typescript/consistent-type-assertions": "warn",
    // interface 与 type 统一
    "typescript/consistent-type-definitions": "warn",
    // 类型导出须集中声明
    "typescript/consistent-type-exports": "warn",
    // 类型导入须用 import type
    "typescript/consistent-type-imports": "warn",
    // 优先点号访问属性
    "typescript/dot-notation": "warn",
    // 函数须显式声明返回类型
    "typescript/explicit-function-return-type": "warn",
    // 类成员须显式声明可访问性
    "typescript/explicit-member-accessibility": "warn",
    // 导出函数须显式声明参数与返回类型
    "typescript/explicit-module-boundary-types": "warn",
    // 禁止易混淆的非空断言
    "typescript/no-confusing-non-null-assertion": "warn",
    // 禁止易混淆的 void 表达式
    "typescript/no-confusing-void-expression": "warn",
    // 禁止已弃用 API
    "typescript/no-deprecated": "warn",
    // 禁止动态 delete 属性
    "typescript/no-dynamic-delete": "warn",
    // 禁止空对象类型
    "typescript/no-empty-object-type": "warn",
    // 禁止显式 any
    "typescript/no-explicit-any": "warn",
    // 禁止多余的空类
    "typescript/no-extraneous-class": "warn",
    // 禁止泛型生成的空对象类型
    "typescript/no-generated-empty-object-type": "warn",
    // 类型导入禁止产生副作用
    "typescript/no-import-type-side-effects": "warn",
    // 禁止可推断的类型标注
    "typescript/no-inferrable-types": "warn",
    // 禁止无效的 void 类型用法
    "typescript/no-invalid-void-type": "warn",
    // 禁止在非期望位置传入 Promise
    "typescript/no-misused-promises": "warn",
    // 禁止同一枚举混合成员类型
    "typescript/no-mixed-enums": "warn",
    // 禁止 namespace
    "typescript/no-namespace": "warn",
    // 禁止非空断言与 ?? 混用
    "typescript/no-non-null-asserted-nullish-coalescing": "warn",
    // 限制指定类型使用
    "typescript/no-restricted-types": "warn",
    // 禁止与布尔字面量比较
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    // 禁止恒真或恒假的条件
    "typescript/no-unnecessary-condition": "warn",
    // 禁止多余命名空间限定符
    "typescript/no-unnecessary-qualifier": "warn",
    // 禁止多余模板表达式
    "typescript/no-unnecessary-template-expression": "warn",
    // 禁止多余类型实参
    "typescript/no-unnecessary-type-arguments": "warn",
    // 禁止多余类型断言
    "typescript/no-unnecessary-type-assertion": "warn",
    // 禁止多余类型约束
    "typescript/no-unnecessary-type-constraint": "warn",
    // 禁止多余类型转换
    "typescript/no-unnecessary-type-conversion": "warn",
    // 禁止多余类型参数
    "typescript/no-unnecessary-type-parameters": "warn",
    // 禁止传入 any 类型实参
    "typescript/no-unsafe-argument": "warn",
    // 禁止将 any 赋值给有类型变量
    "typescript/no-unsafe-assignment": "warn",
    // 禁止调用 any 类型值
    "typescript/no-unsafe-call": "warn",
    // 禁止不安全枚举赋值
    "typescript/no-unsafe-enum-assignment": "warn",
    // 禁止跨枚举类型比较
    "typescript/no-unsafe-enum-comparison": "warn",
    // 禁止 Function 类型
    "typescript/no-unsafe-function-type": "warn",
    // 禁止访问 any 类型成员
    "typescript/no-unsafe-member-access": "warn",
    // 禁止返回 any 类型值
    "typescript/no-unsafe-return": "warn",
    // 禁止不安全的类型断言
    "typescript/no-unsafe-type-assertion": "warn",
    // 禁止 var require
    "typescript/no-var-requires": "warn",
    // 非空断言统一
    "typescript/non-nullable-type-assertion-style": "warn",
    // throw 须抛出 Error 实例
    "typescript/only-throw-error": "warn",
    // 构造器参数属性统一
    "typescript/parameter-properties": "warn",
    // 枚举成员须显式初始化
    "typescript/prefer-enum-initializers": "warn",
    // 优先 find
    "typescript/prefer-find": "warn",
    // 优先函数类型而非调用签名
    "typescript/prefer-function-type": "warn",
    // 优先 includes
    "typescript/prefer-includes": "warn",
    // 优先字面量枚举成员
    "typescript/prefer-literal-enum-member": "warn",
    // 优先空值合并运算符
    "typescript/prefer-nullish-coalescing": "warn",
    // 优先可选链
    "typescript/prefer-optional-chain": "warn",
    // Promise 拒绝须传 Error
    "typescript/prefer-promise-reject-errors": "warn",
    // 可不变的成员须声明 readonly
    "typescript/prefer-readonly": "warn",
    // 优先只读参数类型
    "typescript/prefer-readonly-parameter-types": "warn",
    // 优先 reduce 泛型参数
    "typescript/prefer-reduce-type-parameter": "warn",
    // 优先 RegExp.exec
    "typescript/prefer-regexp-exec": "warn",
    // 链式方法须返回 this 类型
    "typescript/prefer-return-this-type": "warn",
    // 优先 startsWith 与 endsWith
    "typescript/prefer-string-starts-ends-with": "warn",
    // 优先 @ts-expect-error
    "typescript/prefer-ts-expect-error": "warn",
    // 返回 Promise 的函数须 async
    "typescript/promise-function-async": "warn",
    // getter 与 setter 类型须配套
    "typescript/related-getter-setter-pairs": "warn",
    // 异步函数须包含 await
    "typescript/require-await": "warn",
    // 限制 + 运算符操作数类型
    "typescript/restrict-plus-operands": "warn",
    // return await 用法统一
    "typescript/return-await": "warn",
    // void 返回值须严格处理
    "typescript/strict-void-return": "warn",
    // switch 须覆盖所有联合类型分支
    "typescript/switch-exhaustiveness-check": "warn",
    // 可合并的重载签名须合并
    "typescript/unified-signatures": "warn",
    // catch 回调变量须标为 unknown
    "typescript/use-unknown-in-catch-callback-variable": "warn",
    // ── unicorn（101 条）
    // catch 参数命名统一
    "unicorn/catch-error-name": "warn",
    // 断言统一
    "unicorn/consistent-assert": "warn",
    // Date 克隆统一
    "unicorn/consistent-date-clone": "warn",
    // 空数组展开统一
    "unicorn/consistent-empty-array-spread": "warn",
    // 存在性判断统一
    "unicorn/consistent-existence-index-check": "warn",
    // 模板字符串转义统一
    "unicorn/consistent-template-literal-escape": "warn",
    // 空花括号内禁止空格
    "unicorn/empty-brace-spaces": "warn",
    // Error 消息不得为空
    "unicorn/error-message": "warn",
    // 转义序列大小写统一
    "unicorn/escape-case": "warn",
    // 长度比较须显式判断
    "unicorn/explicit-length-check": "warn",
    // 定时器须显式指定延迟
    "unicorn/explicit-timer-delay": "warn",
    // 文件名命名规范
    "unicorn/filename-case": "off",
    // 导入统一
    "unicorn/import-style": "warn",
    // 嵌套调用层数上限
    "unicorn/max-nested-calls": "off",
    // 禁止无规则的 eslint-disable
    "unicorn/no-abusive-eslint-disable": "warn",
    // 禁止访问器递归调用
    "unicorn/no-accessor-recursion": "warn",
    // 禁止用引用类型填充数组
    "unicorn/no-array-fill-with-reference-type": "warn",
    // 禁止原地反转数组
    "unicorn/no-array-reverse": "warn",
    // 禁止原地排序数组
    "unicorn/no-array-sort": "warn",
    // 禁止直接访问 await 结果成员
    "unicorn/no-await-expression-member": "warn",
    // 禁止易混淆的 Array 调用
    "unicorn/no-confusing-array-with": "warn",
    // 禁止 console 参数多余空格
    "unicorn/no-console-spaces": "warn",
    // 禁止 document.cookie
    "unicorn/no-document-cookie": "warn",
    // 禁止十六进制转义字符
    "unicorn/no-hex-escape": "warn",
    // 禁止 instanceof Array
    "unicorn/no-instanceof-array": "warn",
    // 禁止 instanceof 内置对象
    "unicorn/no-instanceof-builtins": "warn",
    // 禁止用 length 作 slice 终点
    "unicorn/no-length-as-slice-end": "warn",
    // 禁止魔法数组扁平深度
    "unicorn/no-magic-array-flat-depth": "warn",
    // 禁止取反条件判断
    "unicorn/no-negated-condition": "warn",
    // 禁止相等判断内取反
    "unicorn/no-negation-in-equality-check": "warn",
    // 禁止嵌套三元表达式
    "unicorn/no-nested-ternary": "warn",
    // 禁止 new Buffer
    "unicorn/no-new-buffer": "warn",
    // 禁止 null
    "unicorn/no-null": "off",
    // 禁止用对象作默认参数
    "unicorn/no-object-as-default-parameter": "warn",
    // 禁止纯静态类
    "unicorn/no-static-only-class": "warn",
    // 禁止将 this 赋值给变量
    "unicorn/no-this-assignment": "warn",
    // 禁止用 typeof 判断 undefined
    "unicorn/no-typeof-undefined": "warn",
    // 禁止多余数组扁平深度
    "unicorn/no-unnecessary-array-flat-depth": "warn",
    // 禁止多余 splice 删除计数
    "unicorn/no-unnecessary-array-splice-count": "warn",

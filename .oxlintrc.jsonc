    // 导出的函数中禁止 this
    "oxc/no-this-in-exported-function": "warn"
  },
  // 按文件模式覆盖
  "overrides": [
    {
      "files": ["**/*.{test,spec}.ts", "**/tests/**"],
      "rules": { "max-lines": "off", "max-lines-per-function": "off" }
    },
    { "files": ["**/tests/e2e/**"], "rules": { "vitest/consistent-test-filename": "off" } },
    {
      "files": ["**/tests/setup.ts"],
      "rules": {
        "vitest/require-hook": "off",
        "vitest/require-top-level-describe": "off",
        "vitest/no-hooks": "off"
      }
    },
    { "files": ["apps/web/src/router/**"], "rules": { "sort-keys": "off" } },
    {
      "files": [
        "apps/web/src/api/**",
        "apps/web/src/features/health/**",
        "apps/web/src/lib/logger.ts",
        "apps/web/src/lib/storage.ts"
      ],
      "rules": {
        "import/no-named-export": "off",
        "import/prefer-default-export": "off",
        "import/exports-last": "off",
        "import/group-exports": "off"
      }
    },
    {
      "files": ["apps/web/src/lib/storage.ts", "apps/web/tests/unit/lib/storage.test.ts"],
      "rules": { "unicorn/no-null": "off" }
    },
    {
      "files": ["apps/web/vite.config.ts", "apps/web/playwright.config.ts"],
      "rules": {
        "new-cap": "off",
        "import/no-nodejs-modules": "off",
        "node/no-process-env": "off"
      }
    }
  ]
}

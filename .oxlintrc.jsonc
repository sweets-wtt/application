{
  // Schema 地址
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // 规则类别
  "categories": {
    // 正确性
    "correctness": "error",
    // 实验性
    "nursery": "error",
    // 严格
    "pedantic": "error",
    // 性能
    "perf": "error",
    // 限制性
    "restriction": "error",
    // 风格
    "style": "error",
    // 可疑代码
    "suspicious": "error"
  },
  // 运行选项
  "options": {
    // 未使用的禁用注释
    "reportUnusedDisableDirectives": "error",
    // 类型感知规则
    "typeAware": true,
    // 类型检查诊断
    "typeCheck": true
  },
  // 插件
  "plugins": ["eslint", "jsdoc", "typescript", "unicorn", "vue", "vitest", "import", "promise", "node", "oxc"],
  // 忽略路径
  "ignorePatterns": ["**/generated/**", "**/auto-imports.d.ts", "**/components.d.ts"],
  // 规则
  "rules": {
    // 标识符长度
    "eslint/id-length": ["error", { "max": 40, "min": 2 }],
    // 构造函数命名
    "eslint/new-cap": [
      "error",
      { "capIsNewExceptions": ["AutoImport", "Components", "Icons", "IconsResolver", "RekaResolver", "UnoCSS"] }
    ],
    // 重复导入
    "eslint/no-duplicate-imports": "off",
    // 未声明变量
    "eslint/no-undef": "off",
    // undefined 标识符
    "eslint/no-undefined": "off",
    // 每作用域一条声明
    "eslint/one-var": ["error", "never"],
    // 正则 u 标志
    "eslint/require-unicode-regexp": "off",
    // 导入语句排序
    "eslint/sort-imports": "off",
    // 对象键排序
    "eslint/sort-keys": "off",
    // 文件名命名
    "unicorn/filename-case": ["error", { "cases": { "camelCase": true, "kebabCase": true, "pascalCase": true } }],
    // null 字面量
    "unicorn/no-null": "off",
    // 测试文件命名
    "vitest/consistent-test-filename": "off",
    // 测试钩子
    "vitest/no-hooks": "off",
    // 导入 vitest 全局 API
    "vitest/no-importing-vitest-globals": "off",
    // describe 标题
    "vitest/prefer-describe-function-title": "off",
    // 断言数量声明
    "vitest/prefer-expect-assertions": ["error", { "onlyFunctionsWithAsyncKeyword": true }],
    // 使用 vitest 全局 API
    "vitest/prefer-importing-vitest-globals": "off",
    // 真值断言匹配器
    "vitest/prefer-to-be-truthy": "off",
    // 钩子组织测试
    "vitest/require-hook": "off",
    // 测试超时声明
    "vitest/require-test-timeout": "off",
    // 顶层 describe
    "vitest/require-top-level-describe": "off",
    // 导出位置
    "import/exports-last": "off",
    // 导入位置
    "import/first": "off",
    // 导出合并
    "import/group-exports": "off",
    // 默认导出
    "import/no-default-export": "off",
    // 具名导出
    "import/no-named-export": "off",
    // 无赋值副作用导入
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "virtual:*"] }],
    // 模块标记
    "import/unambiguous": "off",
    // async/await
    "oxc/no-async-await": "off",
    // 桶文件
    "oxc/no-barrel-file": ["error", { "threshold": 300 }],
    // 可选链
    "oxc/no-optional-chaining": "off",
    // 对象展开属性
    "oxc/no-rest-spread-properties": "off",
    // return await 模式
    "typescript/return-await": ["error", "error-handling-correctness-only"]
  },
  // 文件覆盖
  "overrides": [{
    // 匹配路径
    "files": ["**/*.{test,spec}.ts", "**/tests/**"],
    // 规则
    "rules": {
      // 钩子组织测试
      "vitest/require-hook": "error"
    }
  }]
}

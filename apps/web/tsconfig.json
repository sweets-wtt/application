{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 应用仅做类型检查，不产出编译物
    "noEmit": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"]
}

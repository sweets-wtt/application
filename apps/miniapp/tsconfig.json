// TypeScript - https://www.typescriptlang.org/tsconfig/

{
  // 继承
  "extends": "../../tsconfig.base.json",

  // 编译选项
  "compilerOptions": {
    // 复合
    "composite": true,
    // 输出目录
    "outDir": "dist",
    // 声明目录
    "declarationDir": "dist",
    // JSX
    "jsx": "preserve",
    // 路径别名
    "paths": {
      "@/*": ["./src/*"]
    },
    // 类型
    "types": ["@dcloudio/types"]
  },

  // 包含
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}

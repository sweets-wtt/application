{
  // Schema 地址
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // 行宽
  "printWidth": 120,
  // HTML 空白敏感度
  "htmlWhitespaceSensitivity": "ignore",
  // 标签属性独占一行
  "singleAttributePerLine": false,
  // 对象换行策略
  "objectWrap": "collapse",
  // 运算符换行位置
  "experimentalOperatorPosition": "start",
  // 忽略路径
  "ignorePatterns": ["**/auto-imports.d.ts", "**/components.d.ts", "**/node_modules/**", ".venv/**", "**/dist/**"],
  // 文件覆盖
  "overrides": [{
    // 匹配路径
    "files": ["**/generated/**"],
    // 导入排序
    "sortImports": false
  }],
  // 导入排序
  "sortImports": {
    // 分组顺序
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "type",
      "unknown"
    ],
    // 副作用导入参与排序
    "sortSideEffects": true
  }
}

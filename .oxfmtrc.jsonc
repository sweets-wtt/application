{
  "$schema": "./node_modules/oxfmt/configuration_schema.json", // Schema 地址
  "printWidth": 120, // 行宽
  "tabWidth": 2, // 缩进宽度
  "useTabs": false, // 制表符缩进
  "endOfLine": "lf", // 换行符
  "insertFinalNewline": true, // 末尾换行
  "semi": true, // 分号
  "singleQuote": false, // 单引号
  "jsxSingleQuote": false, // JSX 单引号
  "quoteProps": "as-needed", // 属性引号
  "trailingComma": "all", // 尾逗号
  "bracketSpacing": true, // 括号空格
  "arrowParens": "always", // 箭头括号
  "bracketSameLine": false, // 标签闭合
  "htmlWhitespaceSensitivity": "ignore", // 空白敏感度
  "vueIndentScriptAndStyle": false, // Vue 块缩进
  "embeddedLanguageFormatting": "auto", // 内嵌格式化
  "proseWrap": "preserve", // 折行方式
  "jsdoc": false, // JSDoc 格式化
  "sortPackageJson": false, // package.json 排序
  "astro": false, // Astro 支持
  "svelte": false, // Svelte 支持
  "sortTailwindcss": false, // Tailwind 排序
  "associations": [], // 语言关联
  "objectWrap": "collapse", // 对象换行
  "singleAttributePerLine": true, // 属性分行
  "experimentalOperatorPosition": "start", // 运算符位置
  "ignorePatterns": ["**/auto-imports.d.ts", "**/node_modules/**", ".venv/**", "**/dist/**"], // 忽略文件
  // 文件覆盖
  "overrides": [{
    "files": ["**/generated/**"], // 契约生成物
    "sortImports": false // 导入排序
  }],
  // 导入排序
  "sortImports": {
    // 分组
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "type",
      "unknown"
    ],
    "order": "asc", // 排序方向
    "ignoreCase": true, // 忽略大小写
    "newlinesBetween": true, // 分组空行
    "internalPattern": ["@/", "~/", "#"], // 内部前缀
    "sortSideEffects": true, // 副作用导入排序
    "partitionByComment": false, // 按注释分区
    "partitionByNewline": false, // 按空行分区
    "customGroups": [] // 自定义分组
  }
}

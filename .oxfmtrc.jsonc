{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // 箭头函数参数括号
  "arrowParens": "always",
  // 多行元素闭合括号
  "bracketSameLine": false,
  // 对象花括号内空格
  "bracketSpacing": true,
  // 内嵌语言格式化
  "embeddedLanguageFormatting": "auto",
  // 换行符
  "endOfLine": "lf",
  // 运算符在换行时的位置：置于新行行首
  "experimentalOperatorPosition": "start",
  // HTML/Vue 空白敏感度：忽略空白差异
  "htmlWhitespaceSensitivity": "ignore",
  // 文件末尾换行
  "insertFinalNewline": true,
  // JSDoc 格式化：中文注释按语义手工断行，不自动重排
  "jsdoc": false,
  // JSX 属性引号
  "jsxSingleQuote": false,
  // 对象换行
  "objectWrap": "collapse",
  // 行宽
  "printWidth": 100,
  // 对象键引号
  "quoteProps": "as-needed",
  // 语句末尾分号
  "semi": true,
  // 多属性元素
  "singleAttributePerLine": true,
  // 字符串引号
  "singleQuote": false,
  // import 排序
  "sortImports": {
    // 分组顺序
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "type",
      "unknown"
    ],
    // 忽略大小写
    "ignoreCase": true,
    // 内部模块前缀
    "internalPattern": ["@/", "~/", "#"],
    // 分组之间空行
    "newlinesBetween": true,
    // 组内顺序
    "order": "asc",
    // 副作用导入排序
    "sortSideEffects": true
  },
  // package.json 排序交由 dprint
  "sortPackageJson": false,
  // 多行结构尾逗号
  "trailingComma": "all",
  // 缩进宽度（覆盖 .editorconfig）
  "tabWidth": 2,
  // Vue 的 script/style 缩进
  "vueIndentScriptAndStyle": false
}

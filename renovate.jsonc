{
  // 继承推荐配置
  "extends": ["config:best-practices"],

  // 锁文件维护
  "lockFileMaintenance": { "enabled": true },

  "packageRules": [
    {
      // monorepo 类依赖 - minor/patch 分组批量更新
      "groupName": "monorepos",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      // bun 依赖 - 精确升版本
      "matchManagers": ["bun"],
      "rangeStrategy": "bump"
    }
  ],

  "enabledManagers": ["mise", "dockerfile", "docker-compose", "pep621", "bun", "github-actions"]
}

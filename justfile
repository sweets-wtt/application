# justfile - https://just.systems/man/en/

# 设置
set shell := ["bash", "-c"]
set dotenv-load := false
set positional-arguments := false
set unstable

# 变量
compose := "podman compose -f infra/compose.yaml -p application"
registry := env("REGISTRY", "")
tag := env("TAG", "latest")

# 默认 - 列出全部配方
[group('meta')]
[doc('列出全部配方')]
default:
    @just --list --unsorted

# 安装依赖与工具
[group('install')]
[doc('安装依赖与工具')]
[parallel]
install: install-tools install-python install-typescript

# ── 安装 ─────────────────────────

[group('install')]
[doc('安装工具链')]
install-tools:
    mise install --locked

[group('install')]
[doc('同步 Python 依赖')]
install-python:
    mise exec -- uv sync --locked

[group('install')]
[doc('安装前端依赖')]
install-typescript:
    mise exec -- bun install --frozen-lockfile

# ── 检查 ─────────────────────────

[group('lint')]
[doc('运行全部检查')]
[parallel]
lint: lint-format lint-spell lint-secret lint-github lint-compose lint-python lint-typescript lint-api

[group('lint')]
[doc('检查文件格式')]
lint-format:
    mise exec -- dprint check

[group('lint')]
[doc('检查拼写')]
lint-spell:
    mise exec -- typos

[group('lint')]
[doc('检测泄露密钥')]
lint-secret:
    mise exec -- gitleaks git

[group('lint')]
[doc('校验 GitHub 工作流')]
lint-github:
    #!/usr/bin/env bash
    set -euo pipefail
    mise exec -- actionlint
    mise exec -- zizmor .github

[group('lint')]
[doc('校验容器编排配置')]
lint-compose:
    {{compose}} config --quiet

[group('lint')]
[doc('检查 Python 代码')]
lint-python:
    #!/usr/bin/env bash
    set -euo pipefail
    mise exec -- uv run ruff format --check .
    mise exec -- uv run ruff check .
    mise exec -- uv run ty check .

[group('lint')]
[doc('检查 TypeScript 代码')]
lint-typescript:
    #!/usr/bin/env bash
    set -euo pipefail
    mise exec -- bunx oxfmt --check --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'
    mise exec -- bunx oxlint --no-error-on-unmatched-pattern
    mise exec -- bunx tsc -p apps/web/tsconfig.json --noEmit

[group('lint')]
[doc('校验 OpenAPI 契约')]
lint-api:
    mise exec -- vacuum lint --ruleset contracts/http/vacuum.yaml contracts/http/dist/openapi.yaml

# ── 格式化 ───────────────────────

[group('format')]
[doc('格式化全部文件')]
[parallel]
format: format-code format-python format-ts

[group('format')]
[doc('格式化配置与文档')]
format-code:
    mise exec -- dprint fmt

[group('format')]
[doc('格式化 Python 代码')]
format-python:
    mise exec -- uv run ruff format .

[group('format')]
[doc('格式化 TypeScript 代码')]
format-ts:
    mise exec -- bunx oxfmt --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'

# ── 构建与测试 ───────────────────

[group('build')]
[doc('构建')]
build: build-web

[group('build')]
[doc('构建 Web 前端')]
build-web:
    mise exec -- bun run --filter @app/web build

[group('build')]
[doc('构建应用镜像')]
[parallel]
build-image: build-image-server build-image-web

[group('build')]
[doc('构建 Server 镜像')]
build-image-server:
    podman build -f apps/server/Dockerfile -t {{registry}}server:{{tag}} .

[group('build')]
[doc('构建 Web 镜像')]
build-image-web:
    podman build -f apps/web/Dockerfile -t {{registry}}web:{{tag}} .

[group('test')]
[doc('运行全部测试')]
[parallel]
test: test-python test-js

[group('test')]
[doc('运行 Python 测试')]
[working-directory('apps/server')]
test-python:
    mise exec -- uv run --locked pytest

[group('test')]
[doc('运行前端测试')]
test-js:
    mise exec -- bun run --filter @app/* test

[group('test')]
[doc('运行端到端测试')]
test-e2e: build-web
    cd apps/web && mise exec -- bun x playwright test

# ── 契约 ─────────────────────────

[group('contract')]
[doc('打包 OpenAPI 契约制品')]
bundle:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p contracts/http/dist
    mise exec -- bun x @redocly/cli bundle contracts/http/openapi.yaml --output contracts/http/dist/openapi.yaml
    mise exec -- uv run python -c "from pathlib import Path; p=Path('contracts/http/dist/openapi.yaml'); data=p.read_bytes().replace(b'\r\n', b'\n'); banner=b'# Generated by just bundle - do not edit manually\n'; p.write_bytes(data if data.startswith(banner) else banner + data)"

[group('contract')]
[doc('生成契约代码')]
[parallel]
codegen: codegen-py codegen-ts

[group('contract')]
[doc('生成 Python 契约模型')]
codegen-py: bundle
    #!/usr/bin/env bash
    set -euo pipefail
    mise exec -- uv run --locked datamodel-codegen --input contracts/http/dist/openapi.yaml --output apps/server/src/server/contracts.py --disable-timestamp --openapi-scopes paths --strict-types int
    mise exec -- uv run python -c "from pathlib import Path; p=Path('apps/server/src/server/contracts.py'); p.write_bytes(p.read_bytes().replace(b'\r\n', b'\n'))"

[group('contract')]
[doc('生成 TypeScript 契约客户端')]
codegen-ts: bundle
    #!/usr/bin/env bash
    set -euo pipefail
    cd apps/web
    mise exec -- bun x orval
    mise exec -- bun x oxfmt src/contracts

[group('contract')]
[doc('检查契约生成物是否最新')]
check-codegen: codegen
    git diff --exit-code -- apps/server/src/server/contracts.py apps/web/src/contracts/http apps/web/src/contracts/schemas contracts/http/dist

# ── 质量与发布 ───────────────────

[group('ci')]
[doc('扫描依赖漏洞与配置错误')]
audit:
    mise exec -- trivy fs --scanners vuln,misconfig --severity HIGH,CRITICAL --exit-code 1 .

[group('ci')]
[doc('运行 CI 检查')]
[parallel]
ci: lint audit

[group('build')]
[doc('检查前端产物体积预算')]
size: build-web
    mise exec -- bun run --filter @app/web size

[group('meta')]
[doc('安装 Git 钩子')]
hooks:
    mise exec -- lefthook install

# ── 本地服务 ─────────────────────

[group('runtime')]
[doc('启动本地服务')]
up:
    {{compose}} up -d --remove-orphans --wait

[group('runtime')]
[doc('停止本地服务')]
down:
    {{compose}} down --remove-orphans

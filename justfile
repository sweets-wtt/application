# 执行环境
set shell := ["mise", "exec", "--", "bash", "-cu"]
# 默认列出配方
set default-list
# 最低版本
set minimum-version := "1.59.0"
# 位置参数
set positional-arguments

# 必需命令
bash := require("bash")
# uv 命令
uv := "uv run --locked"
# 前端文件
web_files := "--no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,vue,html,css}'"
# 编排命令
compose := "podman compose -f infra/compose.yaml -p application"
# 镜像前缀
registry := env("REGISTRY", "")
# 镜像标签
tag := env("TAG", "latest")

# 安装依赖
[doc("安装")]
[group("install")]
install: install-tools install-python install-typescript

# 工具链
[doc("安装工具链")]
[group("install")]
install-tools:
    mise install --locked

# Python 依赖
[doc("安装 Python 依赖")]
[group("install")]
install-python:
    uv sync --locked

# 前端依赖
[doc("安装 TypeScript 依赖")]
[group("install")]
install-typescript:
    bun install --frozen-lockfile

# 全部检查
[doc("检查")]
[group("check")]
[parallel]
check: check-format check-justfile check-spell check-secret check-github check-compose check-python check-typescript check-api

# justfile 格式
[doc("检查任务文件")]
[group("check")]
check-justfile:
    just --fmt --check

# 文件格式
[doc("检查文件格式")]
[group("check")]
check-format:
    dprint check

# 拼写
[doc("检查拼写")]
[group("check")]
check-spell:
    typos

# 密钥泄露
[doc("检测泄露密钥")]
[group("check")]
check-secret:
    gitleaks git

# GitHub 工作流
[doc("校验 GitHub 工作流")]
[group("check")]
check-github:
    # 语法检查
    actionlint
    # 安全审计
    zizmor .github

# OpenAPI 契约
[doc("校验 OpenAPI 契约")]
[group("check")]
check-api:
    vacuum lint --ruleset contracts/ruleset.yaml contracts/http/dist/openapi.yaml

# 编排配置
[doc("校验容器编排配置")]
[group("check")]
check-compose:
    {{ compose }} config --quiet

# Python 检查
[doc("检查 Python")]
[group("check")]
check-python:
    # 格式
    {{ uv }} ruff format --check .
    # 静态
    {{ uv }} ruff check .
    # 类型
    {{ uv }} ty check .

# TypeScript 检查
[doc("检查 TypeScript")]
[group("check")]
check-typescript:
    # 格式
    bunx oxfmt --check {{ web_files }}
    # 静态
    bunx oxlint --no-error-on-unmatched-pattern
    # 类型
    bunx tsc -p apps/web/tsconfig.json --noEmit

# 全部格式化
[doc("格式化")]
[group("format")]
[parallel]
format: format-code format-justfile format-python format-ts

# justfile 格式化
[doc("格式化任务文件")]
[group("format")]
format-justfile:
    just --fmt

# 配置与文档格式化
[doc("格式化配置与文档")]
[group("format")]
format-code:
    dprint fmt

# Python 格式化
[doc("格式化 Python")]
[group("format")]
format-python:
    # 格式化
    {{ uv }} ruff format .
    # 自动修复
    {{ uv }} ruff check --fix .

# TypeScript 格式化
[doc("格式化 TypeScript")]
[group("format")]
format-ts:
    # 自动修复
    bunx oxlint --fix --no-error-on-unmatched-pattern
    # 格式化
    bunx oxfmt {{ web_files }}

# 构建
[doc("构建")]
[group("build")]
build: build-web

# 前端构建
[doc("构建 Web")]
[group("build")]
build-web:
    bun run --filter @app/web build

# 全部镜像
[doc("构建应用镜像")]
[group("build")]
[parallel]
build-image: build-image-server build-image-web

# 前端镜像
[doc("构建 Web 镜像")]
[group("build")]
build-image-web:
    podman build -f apps/web/Dockerfile -t {{ registry }}web:{{ tag }} .

# 后端镜像
[doc("构建 Server 镜像")]
[group("build")]
build-image-server:
    podman build -f apps/server/Dockerfile -t {{ registry }}server:{{ tag }} .

# 全部测试
[doc("测试")]
[group("test")]
test: test-python test-typescript

# 后端测试
[doc("测试 Python")]
[group("test")]
[working-directory("apps/server")]
test-python:
    {{ uv }} pytest

# 前端单元测试
[doc("测试 Web")]
[group("test")]
test-typescript:
    bun run --filter @app/* test

# 端到端测试
[doc("测试端到端")]
[group("test")]
[working-directory("apps/web")]
test-e2e: build-web
    # 运行测试
    bunx playwright test

# 打包契约
[doc("打包契约")]
[group("contract")]
bundle:
    # 合并契约
    bunx redocly bundle contracts/http/openapi.yaml --output contracts/http/dist/openapi.yaml
    # 写入标记
    just bundle-stamp

# 写入生成标记
[doc("写入生成标记")]
[group("contract")]
[private]
bundle-stamp:
    #!/usr/bin/env -S mise exec -- uv run --locked python
    from pathlib import Path

    # 首行标记
    path = Path("contracts/http/dist/openapi.yaml")
    header = "# Generated by just bundle - do not edit manually\n"
    path.write_text(header + path.read_text(encoding="utf-8"), encoding="utf-8", newline="\n")

# 生成契约代码
[doc("生成契约")]
[group("contract")]
codegen: codegen-python codegen-typescript

# Python 模型
[doc("生成 Python 模型")]
[group("contract")]
codegen-python: bundle
    # 生成模型
    {{ uv }} datamodel-codegen --input contracts/http/dist/openapi.yaml --output apps/server/src/server/generated/contracts.py --disable-timestamp --openapi-scopes paths --strict-types int --formatters black isort
    # 统一换行
    just codegen-py-normalize

# 换行符统一
[doc("统一换行符")]
[group("contract")]
[private]
codegen-py-normalize:
    #!/usr/bin/env -S mise exec -- uv run --locked python
    from pathlib import Path

    # CRLF 转 LF
    path = Path("apps/server/src/server/generated/contracts.py")
    path.write_bytes(path.read_bytes().replace(b"\r\n", b"\n"))

# TypeScript 客户端
[doc("生成 TypeScript 客户端")]
[group("contract")]
[working-directory("apps/web")]
codegen-typescript: bundle
    # 生成客户端
    bunx orval
    # 格式化生成物
    bunx oxfmt src/api/generated

# 契约漂移
[doc("检查契约漂移")]
[group("contract")]
check-codegen: codegen
    git diff --exit-code -- apps/server/src/server/generated/contracts.py apps/web/src/api/generated/http apps/web/src/api/generated/schemas contracts/http/dist

# 漏洞扫描
[doc("扫描漏洞")]
[group("ci")]
audit:
    trivy fs --scanners vuln,misconfig --severity HIGH,CRITICAL --exit-code 1 .

# 运行 CI
[doc("运行 CI")]
[group("ci")]
[parallel]
ci: check audit

# 产物体积
[doc("检查产物体积")]
[group("build")]
size: build-web
    bun run --filter @app/web size

# 安装钩子
[doc("安装钩子")]
[group("meta")]
hooks:
    lefthook install

# 提交信息
[arg("file", help="提交信息文件路径")]
[doc("校验提交信息")]
[group("meta")]
check-commit file:
    cog verify --file "$1"

# 启动服务
[doc("启动本地服务")]
[group("runtime")]
up:
    {{ compose }} up -d --remove-orphans --wait

# 停止服务
[doc("停止本地服务")]
[group("runtime")]
down:
    {{ compose }} down --remove-orphans

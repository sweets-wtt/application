# ── 设置 ─────────────────────────
# 配方经 mise 激活工具链执行 - 各工具无需在此重复前缀
set shell := ["mise", "exec", "--", "bash", "-c"]
# 脚本配方（[script]）同样经 mise 执行
set script-interpreter := ["mise", "exec", "--", "bash", "-eu"]
# 无配方参数时列出全部配方, 免去 default 占位
set default-list
# 低于该版本直接报错, 避免旧版静默忽略新属性
set minimum-version := "1.42.0"

# ── 变量 ─────────────────────────
compose := "podman compose -f infra/compose.yaml -p application"
registry := env("REGISTRY", "")
tag := env("TAG", "latest")

# ── 安装 ─────────────────────────

[group("install")]
[doc("安装")]
[parallel]
install: install-tools install-python install-typescript

[group("install")]
[doc("安装工具链")]
install-tools:
    mise install --locked

[group("install")]
[doc("安装 Python 依赖")]
install-python:
    uv sync --locked

[group("install")]
[doc("安装 TypeScript 依赖")]
install-typescript:
    bun install --frozen-lockfile

# ── 检查 ─────────────────────────

[group("check")]
[doc("检查")]
[parallel]
check: check-format check-spell check-secret check-github check-compose check-python check-typescript check-api

[group("check")]
[doc("检查文件格式")]
check-format:
    dprint check

[group("check")]
[doc("检查拼写")]
check-spell:
    typos

[group("check")]
[doc("检测泄露密钥")]
check-secret:
    gitleaks git

[group("check")]
[doc("校验 GitHub 工作流")]
check-github:
    actionlint
    zizmor .github

[group("check")]
[doc("校验容器编排配置")]
check-compose:
    {{compose}} config --quiet

[group("check")]
[doc("检查 Python")]
check-python:
    uv run ruff format --check .
    uv run ruff check .
    uv run ty check .

[group("check")]
[doc("检查 TypeScript")]
check-typescript:
    bunx oxfmt --check --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'
    bunx oxlint --no-error-on-unmatched-pattern
    bunx tsc -p apps/web/tsconfig.json --noEmit

[group("check")]
[doc("校验 OpenAPI 契约")]
check-api:
    vacuum lint --ruleset contracts/http/vacuum.yaml contracts/http/dist/openapi.yaml

# ── 格式化 ───────────────────────

[group("format")]
[doc("格式化")]
[parallel]
format: format-code format-python format-ts

[group("format")]
[doc("格式化配置与文档")]
format-code:
    dprint fmt

[group("format")]
[doc("格式化 Python")]
format-python:
    ruff format .

[group("format")]
[doc("格式化 TypeScript")]
format-ts:
    bunx oxfmt --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'

# ── 构建与测试 ───────────────────

[group("build")]
[doc("构建")]
build: build-web

[group("build")]
[doc("构建 Web")]
build-web:
    bun run --filter @app/web build

[group("build")]
[doc("构建应用镜像")]
[parallel]
build-image: build-image-server build-image-web

[group("build")]
[doc("构建 Server 镜像")]
build-image-server:
    podman build -f apps/server/Dockerfile -t {{registry}}server:{{tag}} .

[group("build")]
[doc("构建 Web 镜像")]
build-image-web:
    podman build -f apps/web/Dockerfile -t {{registry}}web:{{tag}} .

[group("test")]
[doc("测试")]
[parallel]
test: test-python test-js

[group("test")]
[doc("测试 Python")]
[working-directory("apps/server")]
test-python:
    uv run --locked pytest

[group("test")]
[doc("测试 Web")]
test-js:
    bun run --filter @app/* test

[group("test")]
[doc("测试端到端")]
test-e2e: build-web
    bun x playwright test

# ── 契约 ─────────────────────────

[group("contract")]
[doc("打包契约")]
bundle:
    mkdir -p contracts/http/dist
    bun x @redocly/cli bundle contracts/http/openapi.yaml --output contracts/http/dist/openapi.yaml
    uv run python -c "from pathlib import Path; p=Path('contracts/http/dist/openapi.yaml'); data=p.read_bytes().replace(b'\r\n', b'\n'); banner=b'# Generated by just bundle - do not edit manually\n'; p.write_bytes(data if data.startswith(banner) else banner + data)"

[group("contract")]
[doc("生成契约")]
[parallel]
codegen: codegen-py codegen-ts

[group("contract")]
[doc("生成 Python 模型")]
codegen-py: bundle
    uv run --locked datamodel-codegen --input contracts/http/dist/openapi.yaml --output apps/server/src/server/contracts.py --disable-timestamp --openapi-scopes paths --strict-types int
    uv run python -c "from pathlib import Path; p=Path('apps/server/src/server/contracts.py'); p.write_bytes(p.read_bytes().replace(b'\r\n', b'\n'))"

[group("contract")]
[doc("生成 TypeScript 客户端")]
[working-directory("apps/web")]
codegen-ts: bundle
    bun x orval
    bun x oxfmt src/contracts

[group("contract")]
[doc("检查契约漂移")]
check-codegen: codegen
    git diff --exit-code -- apps/server/src/server/contracts.py apps/web/src/contracts/http apps/web/src/contracts/schemas contracts/http/dist

# ── 质量与发布 ───────────────────

[group("ci")]
[doc("扫描漏洞")]
audit:
    trivy fs --scanners vuln,misconfig --severity HIGH,CRITICAL --exit-code 1 .

[group("ci")]
[doc("运行 CI")]
[parallel]
ci: check audit

[group("build")]
[doc("检查产物体积")]
size: build-web
    bun run --filter @app/web size

[group("meta")]
[doc("安装钩子")]
hooks:
    lefthook install

[group("meta")]
[doc("校验提交信息")]
check-commit file:
    cog verify --file {{file}}

# ── 本地服务 ─────────────────────

[group("runtime")]
[doc("启动本地服务")]
up:
    {{compose}} up -d --remove-orphans --wait

[group("runtime")]
[doc("停止本地服务")]
down:
    {{compose}} down --remove-orphans

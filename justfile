# ── 设置 ─────────────────────────
# 配方经 mise 激活工具链执行 - 各工具无需在此重复前缀
set shell := ["mise", "exec", "--", "bash", "-c"]
# 脚本配方（[script]）同样经 mise 执行
set script-interpreter := ["mise", "exec", "--", "bash", "-eu"]
# 无配方参数时列出全部配方, 免去 default 占位
set default-list
# 低于该版本直接报错, 避免旧版静默忽略新属性
set minimum-version := "1.42.0"

# ── 变量 ─────────────────────────
compose := "podman compose -f infra/compose.yaml -p application"
registry := env("REGISTRY", "")
tag := env("TAG", "latest")

# ── 安装 ─────────────────────────

[doc("安装")]
[group("install")]
[parallel]
install: install-tools install-python install-typescript

[doc("安装工具链")]
[group("install")]
install-tools:
    mise install --locked

[doc("安装 Python 依赖")]
[group("install")]
install-python:
    uv sync --locked

[doc("安装 TypeScript 依赖")]
[group("install")]
install-typescript:
    bun install --frozen-lockfile

# ── 检查 ─────────────────────────

[doc("检查")]
[group("check")]
[parallel]
check: check-format check-justfile check-spell check-secret check-github check-compose check-python check-typescript check-api

[doc("检查文件格式")]
[group("check")]
check-format:
    dprint check

[doc("检查任务文件")]
[group("check")]
check-justfile:
    just --fmt --check

[doc("检查拼写")]
[group("check")]
check-spell:
    typos

[doc("检测泄露密钥")]
[group("check")]
check-secret:
    gitleaks git

[doc("校验 GitHub 工作流")]
[group("check")]
check-github:
    actionlint
    zizmor .github

[doc("校验容器编排配置")]
[group("check")]
check-compose:
    {{ compose }} config --quiet

[doc("检查 Python")]
[group("check")]
check-python:
    uv run ruff format --check .
    uv run ruff check .
    uv run ty check .

[doc("检查 TypeScript")]
[group("check")]
check-typescript:
    bunx oxfmt --check --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,vue,html,css}'
    bunx oxlint --no-error-on-unmatched-pattern
    bunx tsc -p apps/web/tsconfig.json --noEmit

[doc("校验 OpenAPI 契约")]
[group("check")]
check-api:
    vacuum lint --ruleset contracts/http/vacuum.yaml contracts/http/dist/openapi.yaml

# ── 格式化 ───────────────────────

[doc("格式化")]
[group("format")]
[parallel]
format: format-code format-justfile format-python format-ts

[doc("格式化配置与文档")]
[group("format")]
format-code:
    dprint fmt

[doc("格式化任务文件")]
[group("format")]
format-justfile:
    just --fmt

[doc("格式化 Python")]
[group("format")]
format-python:
    ruff format .

[doc("格式化 TypeScript")]
[group("format")]
format-ts:
    bunx oxfmt --no-error-on-unmatched-pattern '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,vue,html,css}'

# ── 构建与测试 ───────────────────

[doc("构建")]
[group("build")]
build: build-web

[doc("构建 Web")]
[group("build")]
build-web:
    bun run --filter @app/web build

[doc("构建应用镜像")]
[group("build")]
[parallel]
build-image: build-image-server build-image-web

[doc("构建 Server 镜像")]
[group("build")]
build-image-server:
    podman build -f apps/server/Dockerfile -t {{ registry }}server:{{ tag }} .

[doc("构建 Web 镜像")]
[group("build")]
build-image-web:
    podman build -f apps/web/Dockerfile -t {{ registry }}web:{{ tag }} .

[doc("测试")]
[group("test")]
[parallel]
test: test-python test-js

[doc("测试 Python")]
[group("test")]
[working-directory("apps/server")]
test-python:
    uv run --locked pytest

[doc("测试 Web")]
[group("test")]
test-js:
    bun run --filter @app/* test

[doc("测试端到端")]
[group("test")]
test-e2e: build-web
    bun x playwright test

# ── 契约 ─────────────────────────

[doc("打包契约")]
[group("contract")]
bundle:
    mkdir -p contracts/http/dist
    bun x @redocly/cli bundle contracts/http/openapi.yaml --output contracts/http/dist/openapi.yaml
    sed -i '1i # Generated by just bundle - do not edit manually' contracts/http/dist/openapi.yaml

[doc("生成契约")]
[group("contract")]
[parallel]
codegen: codegen-py codegen-ts

[doc("生成 Python 模型")]
[group("contract")]
codegen-py: bundle
    uv run --locked datamodel-codegen --input contracts/http/dist/openapi.yaml --output apps/server/src/server/generated/contracts.py --disable-timestamp --openapi-scopes paths --strict-types int
    uv run python -c "from pathlib import Path; p=Path('apps/server/src/server/generated/contracts.py'); p.write_bytes(p.read_bytes().replace(b'\r\n', b'\n'))"

[doc("生成 TypeScript 客户端")]
[group("contract")]
[working-directory("apps/web")]
codegen-ts: bundle
    bun x orval
    bun x oxfmt src/contracts

[doc("检查契约漂移")]
[group("contract")]
check-codegen: codegen
    git diff --exit-code -- apps/server/src/server/generated/contracts.py apps/web/src/contracts/http apps/web/src/contracts/schemas contracts/http/dist

# ── 数据库 ───────────────────────

[doc("应用迁移")]
[group("db")]
[working-directory("apps/server")]
migrate:
    uv run --locked alembic upgrade head

[doc("生成迁移")]
[group("db")]
[working-directory("apps/server")]
migration message:
    uv run --locked alembic revision --autogenerate -m "{{ message }}"

[doc("回退迁移")]
[group("db")]
[working-directory("apps/server")]
rollback:
    uv run --locked alembic downgrade -1

[doc("查看迁移状态")]
[group("db")]
[working-directory("apps/server")]
migrate-status:
    uv run --locked alembic current

# ── 质量与发布 ───────────────────

[doc("扫描漏洞")]
[group("ci")]
audit:
    trivy fs --scanners vuln,misconfig --severity HIGH,CRITICAL --exit-code 1 .

[doc("运行 CI")]
[group("ci")]
[parallel]
ci: check audit

[doc("检查产物体积")]
[group("build")]
size: build-web
    bun run --filter @app/web size

[doc("安装钩子")]
[group("meta")]
hooks:
    lefthook install

[doc("校验提交信息")]
[group("meta")]
check-commit file:
    cog verify --file {{ file }}

# ── 本地服务 ─────────────────────

[doc("启动本地服务")]
[group("runtime")]
up:
    {{ compose }} up -d --remove-orphans --wait

[doc("停止本地服务")]
[group("runtime")]
down:
    {{ compose }} down --remove-orphans

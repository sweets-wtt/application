# Caddy 配置 - 入口代理
# 自动 HTTPS 为默认行为, 无需声明入口、重定向与证书解析器

{
	# ACME 证书邮箱
	email {$ACME_EMAIL}
	# 关闭管理接口 - 容器内无需远程配置
	admin off
}

# 认证服务 - Casdoor 登录/注册/管理台
auth.{$AUTH_DOMAIN} {
	reverse_proxy casdoor:8000
}

# Web 应用 - 唯一公网入口, 鉴权由 FastAPI 校验 JWT
web.{$AUTH_DOMAIN} {
	# 静态资源、SPA 回退与 API 反代由 Nginx 处理
	reverse_proxy web:80
}

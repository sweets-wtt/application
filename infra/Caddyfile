# Caddy 配置 - 入口代理
# 自动 HTTPS 为默认行为, 无需声明入口、重定向与证书解析器

{
	# ACME 证书邮箱
	email {$ACME_EMAIL}
	# 关闭管理接口 - 容器内无需远程配置
	admin off
}

# 认证门户
auth.{$AUTH_DOMAIN} {
	reverse_proxy authelia:9090
}

# Web 应用 - 唯一公网入口
web.{$AUTH_DOMAIN} {
	# 前置于应用的前置鉴权 - 成功后透传用户头
	forward_auth authelia:9090 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}

	# 静态资源与 SPA 回退由 Nginx 处理
	reverse_proxy web:80
}

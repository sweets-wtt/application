# PostgreSQL
# 超级用户密码
POSTGRES_PASSWORD=
# 应用账户密码
POSTGRES_APP_PASSWORD=
# Authelia 账户密码
POSTGRES_AUTHELIA_PASSWORD=

# Restic
# 备份仓库密码
RESTIC_PASSWORD=

# Valkey
# 应用账户密码
VALKEY_APP_PASSWORD=

# Garage
# RPC 密钥
GARAGE_RPC_SECRET=
# S3 访问密钥 ID（至少 16 字符）
GARAGE_S3_ACCESS_KEY=
# S3 私有密钥（至少 16 字符）
GARAGE_S3_SECRET_KEY=
# 默认存储桶
GARAGE_DEFAULT_BUCKET=

# Hatchet - 官方环境变量
# Cookie 签名密钥
SERVER_AUTH_COOKIE_SECRETS=
# 主加密密钥集
SERVER_ENCRYPTION_MASTER_KEYSET=
# JWT 公钥集
SERVER_ENCRYPTION_JWT_PUBLIC_KEYSET=
# JWT 私钥集
SERVER_ENCRYPTION_JWT_PRIVATE_KEYSET=
# 客户端令牌 - api/worker 使用
HATCHET_CLIENT_TOKEN=

# Authelia - 官方环境变量
# 会话密钥（至少 20 字符）
AUTHELIA_SESSION_SECRET=
# 存储加密密钥（至少 20 字符）
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# 重置密码 JWT 密钥（至少 20 字符）
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=

# 域名
# 根域名（子域 auth. / web. / traefik.；Authelia 要求含句点，本地默认走公共 DNS 127.0.0.1）
AUTH_DOMAIN=localtest.me

# OpenObserve - 官方环境变量
# root 用户邮箱
ZO_ROOT_USER_EMAIL=root@example.com
# root 用户密码
ZO_ROOT_USER_PASSWORD=

# 采集器
# OpenObserve Basic 认证头
OPENOBSERVE_AUTHORIZATION=

# Traefik
# ACME 证书邮箱
ACME_EMAIL=

# Server
# 应用镜像
SERVER_IMAGE=server:latest

# Web
# 前端镜像
WEB_IMAGE=web:latest

# Web 构建 - Vite 官方 VITE_ 前缀
# 遥测端点
VITE_TELEMETRY_URL=
# OIDC 签发者
VITE_OIDC_ISSUER=
# OIDC 客户端 ID
VITE_OIDC_CLIENT_ID=
# API 基础地址
VITE_API_BASE_URL=
# 心跳间隔
VITE_HEARTBEAT_INTERVAL=

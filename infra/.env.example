# PostgreSQL
# 口令
POSTGRES_PASSWORD=
# 应用口令
POSTGRES_APP_PASSWORD=
# Authelia 口令
POSTGRES_AUTHELIA_PASSWORD=

# Restic
# 备份仓库口令
RESTIC_PASSWORD=

# Valkey
# ACL 口令
VALKEY_APP_PASSWORD=

# Garage
# RPC 密钥
GARAGE_RPC_SECRET=
# S3 访问密钥(至少 16 字符)
GARAGE_S3_ACCESS_KEY=
# S3 秘密密钥(至少 16 字符)
GARAGE_S3_SECRET_KEY=
# 默认桶名
GARAGE_DEFAULT_BUCKET=

# Hatchet
# Cookie 密钥
HATCHET_AUTH_COOKIE_SECRETS=
# 主密钥集
HATCHET_MASTER_KEYSET=
# JWT 公钥集
HATCHET_JWT_PUBLIC_KEYSET=
# JWT 私钥集
HATCHET_JWT_PRIVATE_KEYSET=
# 客户端令牌 - api/worker 使用
HATCHET_CLIENT_TOKEN=

# Authelia
# 会话密钥(至少 20 字符)
AUTHELIA_SESSION_SECRET=
# 存储加密密钥(至少 20 字符)
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# 重置口令 JWT 密钥(至少 20 字符)
AUTHELIA_RESET_PASSWORD_JWT_SECRET=

# 域名
# 根域名(子域:auth. / web. / traefik.;Authelia 要求含句点,本地默认走 public DNS 127.0.0.1)
AUTH_DOMAIN=localtest.me

# OpenObserve
# root 用户邮箱
ZO_ROOT_USER_EMAIL=root@example.com
# root 用户口令
ZO_ROOT_USER_PASSWORD=

# 采集器
# OpenObserve Basic 认证头
OPENOBSERVE_AUTHORIZATION=

# Traefik
# ACME 证书邮箱
ACME_EMAIL=

# Server
# 镜像
SERVER_IMAGE=server:latest

# Web
# 镜像
WEB_IMAGE=web:latest

# Web 构建
# 遥测端点
VITE_TELEMETRY_URL=
# OIDC 发行方
VITE_OIDC_ISSUER=
# OIDC 客户端 ID
VITE_OIDC_CLIENT_ID=
# API 基地址
VITE_API_BASE_URL=
# 心跳间隔
VITE_HEARTBEAT_INTERVAL=

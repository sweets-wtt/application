# Compose 环境变量 - https://docs.docker.com/compose/how-tos/environment-variables/

# 复制为同目录 .env 并填值

# Server 镜像
SERVER_IMAGE=

# Web 镜像
WEB_IMAGE=

# PostgreSQL 超管口令
POSTGRES_PASSWORD=

# PostgreSQL 应用角色口令
POSTGRES_APP_PASSWORD=

# 数据库连接 URL
DATABASE__URL=

# Garage RPC 密钥
GARAGE_RPC_SECRET=

# Garage 默认桶名
GARAGE_DEFAULT_BUCKET=

# Garage S3 访问密钥
GARAGE_S3_ACCESS_KEY=

# Garage S3 秘密密钥
GARAGE_S3_SECRET_KEY=

# 归档仓库口令
RESTIC_PASSWORD=

# Valkey ACL 口令
VALKEY_APP_PASSWORD=

# 允许的实时 Origin
REALTIME_ORIGINS=

# 观测根用户邮箱
OBSERVE_ROOT_EMAIL=

# 观测根用户口令
OBSERVE_ROOT_PASSWORD=

# 观测 Basic 凭据
OBSERVE_AUTH_BASIC=

# 遥测端点 公网入口
TELEMETRY_URL=

# Hatchet 数据库口令
HATCHET_DB_PASSWORD=

# Hatchet 客户端令牌
HATCHET_CLIENT_TOKEN=

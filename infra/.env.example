# Compose 环境变量 - `https://docs.docker.com/compose/how-tos/environment-variables/`

# 仓库口令
RESTIC_PASSWORD=

# PostgreSQL 口令
POSTGRES_PASSWORD=

# PostgreSQL 应用口令
POSTGRES_APP_PASSWORD=

# Valkey ACL 口令
VALKEY_APP_PASSWORD=

# Garage RPC 密钥
GARAGE_RPC_SECRET=

# Garage 默认桶名
GARAGE_DEFAULT_BUCKET=

# Garage S3 访问密钥
GARAGE_S3_ACCESS_KEY=

# Garage S3 秘密密钥
GARAGE_S3_SECRET_KEY=

# Hatchet 主密钥集
HATCHET_MASTER_KEYSET=

# Hatchet JWT 公钥集
HATCHET_JWT_PUBLIC_KEYSET=

# Hatchet JWT 私钥集
HATCHET_JWT_PRIVATE_KEYSET=

# Hatchet Cookie 密钥
HATCHET_AUTH_COOKIE_SECRETS=

# authentik 实例密钥
AUTHENTIK_SECRET_KEY=

# authentik 引导管理员口令
AUTHENTIK_BOOTSTRAP_PASSWORD=

# authentik 引导 API 令牌
AUTHENTIK_BOOTSTRAP_TOKEN=

# authentik 验收地址
AUTHENTIK_URL=http://localhost:9000

# OpenObserve root 用户邮箱
ZO_ROOT_USER_EMAIL=root@example.com

# OpenObserve root 用户口令
ZO_ROOT_USER_PASSWORD=

# OpenObserve Basic 认证头
OPENOBSERVE_AUTHORIZATION=

# OpenObserve 验收地址
OPENOBSERVE_URL=http://localhost:5080

# authentik 对外域名
AUTHENTIK_DOMAIN=authentik.localhost

# Traefik 仪表板域名
TRAEFIK_DOMAIN=traefik.localhost

# ACME 证书邮箱
ACME_EMAIL=

# Server 镜像
SERVER_IMAGE=

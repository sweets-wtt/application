# PostgreSQL 密码
POSTGRES_PASSWORD=
# PostgreSQL 应用密码
POSTGRES_APP_PASSWORD=
# PostgreSQL Authelia 密码
POSTGRES_AUTHELIA_PASSWORD=

# Restic 备份密码
RESTIC_PASSWORD=

# Valkey 应用密码
VALKEY_APP_PASSWORD=

# Garage RPC 密钥
GARAGE_RPC_SECRET=
# Garage S3 访问密钥
GARAGE_S3_ACCESS_KEY=
# Garage S3 私有密钥
GARAGE_S3_SECRET_KEY=
# Garage 默认存储桶
GARAGE_DEFAULT_BUCKET=

# Authelia 会话密钥
AUTHELIA_SESSION_SECRET=
# Authelia 存储加密密钥
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# Authelia 重置密码 JWT 密钥
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=

# 根域名
AUTH_DOMAIN=localtest.me

# OpenObserve root 用户邮箱
ZO_ROOT_USER_EMAIL=root@example.com
# OpenObserve root 用户密码
ZO_ROOT_USER_PASSWORD=

# OpenObserve 认证令牌 - 格式 Basic base64(邮箱:口令)
# 生成：echo -n "root@example.com:<口令>" | base64
OPENOBSERVE_AUTHORIZATION=

# ACME 证书邮箱
ACME_EMAIL=

# Server 应用镜像
SERVER_IMAGE=

# Web 前端镜像
WEB_IMAGE=

# Web 遥测端点
VITE_TELEMETRY_URL=
# Web OIDC 签发者
VITE_OIDC_ISSUER=
# Web OIDC 客户端 ID
VITE_OIDC_CLIENT_ID=
# Web API 基础地址
VITE_API_BASE_URL=
# Web 心跳间隔
VITE_HEARTBEAT_INTERVAL=

# Compose 环境变量 - `https://docs.docker.com/compose/how-tos/environment-variables/`

# 仓库口令
RESTIC_PASSWORD=

# PostgreSQL 口令
POSTGRES_PASSWORD=

# PostgreSQL 应用口令
POSTGRES_APP_PASSWORD=

# PostgreSQL Authelia 口令
POSTGRES_AUTHELIA_PASSWORD=

# Valkey ACL 口令
VALKEY_APP_PASSWORD=

# Garage RPC 密钥
GARAGE_RPC_SECRET=

# Garage 默认桶名
GARAGE_DEFAULT_BUCKET=

# Garage S3 访问密钥(至少 16 字符)
GARAGE_S3_ACCESS_KEY=

# Garage S3 秘密密钥(至少 16 字符)
GARAGE_S3_SECRET_KEY=

# Hatchet 主密钥集
HATCHET_MASTER_KEYSET=

# Hatchet JWT 公钥集
HATCHET_JWT_PUBLIC_KEYSET=

# Hatchet JWT 私钥集
HATCHET_JWT_PRIVATE_KEYSET=

# Hatchet Cookie 密钥
HATCHET_AUTH_COOKIE_SECRETS=

# Hatchet 客户端令牌
HATCHET_CLIENT_TOKEN=

# Authelia 会话密钥(至少 20 字符)
AUTHELIA_SESSION_SECRET=

# Authelia 存储加密密钥(至少 20 字符)
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Authelia 重置口令 JWT 密钥(至少 20 字符)
AUTHELIA_RESET_PASSWORD_JWT_SECRET=

# 根域名(子域:auth. / web. / traefik.;Authelia 要求含句点,本地默认走 public DNS 127.0.0.1)
AUTH_DOMAIN=localtest.me

# OpenObserve root 用户邮箱
ZO_ROOT_USER_EMAIL=root@example.com

# OpenObserve root 用户口令
ZO_ROOT_USER_PASSWORD=

# OpenObserve Basic 认证头
OPENOBSERVE_AUTHORIZATION=

# ACME 证书邮箱
ACME_EMAIL=

# Server 镜像
SERVER_IMAGE=

# Web 镜像
WEB_IMAGE=

# Web 构建参数
VITE_TELEMETRY_URL=
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_API_BASE_URL=
VITE_HEARTBEAT_INTERVAL=

# ── 版本控制与仓库元数据 ──

# Git 目录
.git/
# GitHub 工作流与动作
.github/
# 本地工具配置
**/.reasonix/

# ── 环境变量 ──

# 实际配置
**/.env
# 派生配置
**/.env.*

# ── 依赖 ──

# npm 与 bun 依赖
**/node_modules/
# Python 虚拟环境
**/.venv/

# ── 日志 ──

**/*.log
# 轮转日志
**/*.log.*

# ── Python ──

# 字节码目录
**/__pycache__/
# 编译产物
**/*.py[cod]
# Pytest 缓存
**/.pytest_cache
# Ruff 缓存
**/.ruff_cache
# Hypothesis 缓存
**/.hypothesis
# Pytest 临时目录
**/pytest-of-*/
# 构建元数据
**/*.egg-info/

# ── 覆盖率 ──

# 数据文件
**/.coverage
# 派生数据文件
**/.coverage.*
# HTML 报告
**/htmlcov/

# ── TypeScript ──

# 增量构建缓存
**/*.tsbuildinfo

# ── 构建产物 ──

# 各应用构建输出
**/dist/
# task 增量缓存
**/.task/

# ── 构建无关的仓库内容 ──

# 测试目录
apps/*/tests/
# 服务编排
infra/
# API 契约
contracts/

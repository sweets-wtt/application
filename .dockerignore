# 版本控制目录
.git/

# 环境变量文件
**/.env
# 环境变量派生文件
**/.env.*

# 依赖目录
**/node_modules/
# 虚拟环境
**/.venv/

# 日志文件
**/*.log
# 轮转日志
**/*.log.*

# 字节码
**/__pycache__/
# 编译产物
**/*.py[cod]
# Pytest 缓存
**/.pytest_cache
# Ruff 缓存
**/.ruff_cache
# Hypothesis 缓存
**/.hypothesis
# 增量构建缓存
**/*.tsbuildinfo
# Pytest 临时目录
**/pytest-of-*/

# 覆盖率
**/.coverage
# 覆盖率派生产物
**/.coverage.*
# 覆盖率报告目录
**/htmlcov/

# 构建产物
**/dist/
# 构建元数据
**/*.egg-info/
# 任务增量缓存
**/.task/

# 本地工具配置
**/.reasonix/
# 部署密钥
infra/secrets/

# 仓库元数据
.github/
# 测试目录
apps/*/tests/
# 服务编排
infra/
# API 契约
contracts/
